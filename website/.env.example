# 预约接收端（必填，至少 24 个字符；不要提交真实值）
WEBSITE_ADMIN_TOKEN=replace-with-a-random-token-at-least-24-chars

# 线索持久化目录（默认 website/server/data）
WEBSITE_STORE_DIR=server/data

# 部署在 nginx 等反向代理后时设为 1，按 X-Forwarded-For 限流
WEBSITE_TRUST_PROXY=0

# 本地联调：控制台 API / 官网 API 的目标地址
WEBSITE_API_TARGET=http://127.0.0.1:8080

# 生产域名确定后再设置；预览版本保持 noindex
# VITE_SITE_ORIGIN=https://example.com
# VITE_ALLOW_INDEX=1
