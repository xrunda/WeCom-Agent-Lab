# 复制为 .env.local 后填写；.env.local 已被 .gitignore 忽略，严禁提交
# 所有密钥只在本地使用，不要贴到聊天/文档/截图里

# ---- 企业身份 ----
WECOM_CORP_ID=
# 自建应用（用于客户联系/客户群接口）
WECOM_APP_SECRET=
WECOM_AGENT_ID=

# ---- 群机器人 / 消息推送（仅内部群，用于边界对照实验）----
WECOM_GROUP_WEBHOOK_URL=

# ---- 智能机器人 API 模式（仅单聊/内部群）----
# 长连接
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# URL 回调
WECOM_BOT_TOKEN=
WECOM_BOT_ENCODING_AES_KEY=

# ---- 会话内容存档（外部客户群读消息的唯一官方路径）----
# 私钥建议放文件，不要直接写进环境变量
WECOM_ARCHIVE_SECRET=
WECOM_ARCHIVE_PRIVATE_KEY_PATH=./config/archive_private_key.pem

# ---- 本地实验服务 ----
PORT=8787
